# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Database Configuration (Postgres via Supabase Session Pooler)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-<region>-<project-ref>.pooler.supabase.com:5432/postgres?sslmode=require

# Django Configuration
SECRET_KEY=replace-with-your-django-secret-key
DEBUG=False
DJANGO_ALLOWED_HOSTS=myapp.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://myapp.onrender.com
DJANGO_SECURE_SSL_REDIRECT=True